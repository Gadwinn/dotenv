# Uppercase
KEY_TEST=VALUE
KEY_WITH_SPACES 	=	 VALUE WITH SPACES 	

# Lowercase
key_with_quotes='value'
key_with_double_quotes="value"
key_with_equals_sign=value=with=equals=sign
key_with_hash="value#with#hash"
key_with_comment=value # with comment
key_with_quotes_and_comment='value' # with comment

# Multiline
key_on_3_lines = """
value
on
3 lines
"""

# Empty
key_without_value=
key_empty_value=""

# export key
export KEY_EXPORTED=value
